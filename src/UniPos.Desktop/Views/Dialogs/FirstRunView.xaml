<UserControl x:Class="UniPos.Desktop.Views.Dialogs.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UniPos.Desktop.Localization"
             xmlns:infra="clr-namespace:UniPos.Desktop.Infrastructure"
             Width="640">
    <UserControl.Resources>
        <!-- A kind of place: a card that is outlined when chosen. -->
        <Style x:Key="VenueTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tile" CornerRadius="10" BorderThickness="1" Padding="14,12"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Button Content="{l:T FirstRun.Later}" Command="{Binding LaterCommand}" IsCancel="True" />
            <Button Content="{l:T FirstRun.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="8,0,0,0" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="{l:T FirstRun.Intro}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,14" />

            <TextBlock Text="{l:T Settings.StoreName}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
            <TextBox x:Name="NameBox" Text="{Binding Settings.StoreName}" />

            <TextBlock Text="{l:T FirstRun.Venue}" Style="{StaticResource FieldLabel}" Margin="0,18,0,2" />
            <TextBlock Text="{l:T FirstRun.VenueHint}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Venues}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource VenueTile}" GroupName="Venue" IsChecked="{Binding IsSelected}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Columns="2" Margin="0,10,0,0">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{l:T Settings.TaxRate}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding Settings.TaxRate, StringFormat=0.####}" />
                </StackPanel>
                <StackPanel Margin="8,0,0,0" IsEnabled="{Binding Settings.LbpEnabled}">
                    <TextBlock Text="{l:T Settings.LbpRate}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <TextBox infra:GroupDigits.IsEnabled="True" Text="{Binding LbpRate}" />
                </StackPanel>
            </UniformGrid>
            <CheckBox IsChecked="{Binding Settings.PricesIncludeTax}" Margin="0,12,0,6">
                <TextBlock Text="{l:T Settings.PricesIncludeTax}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox IsChecked="{Binding Settings.LbpEnabled}">
                <TextBlock Text="{l:T Settings.LbpEnabled}" TextWrapping="Wrap" />
            </CheckBox>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding CanAddSampleMenu, Converter={StaticResource BoolToVis}}">
                <CheckBox IsChecked="{Binding AddSampleMenu}">
                    <TextBlock Text="{l:T FirstRun.SampleMenu}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </CheckBox>
                <TextBlock Text="{l:T FirstRun.SampleMenuHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="24,2,0,0" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
