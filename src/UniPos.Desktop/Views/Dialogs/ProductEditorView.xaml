<UserControl x:Class="UniPos.Desktop.Views.Dialogs.ProductEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UniPos.Desktop.Localization"
             xmlns:infra="clr-namespace:UniPos.Desktop.Infrastructure">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="{Binding SaveAndNewText}" Command="{Binding SaveAndNewCommand}" MinWidth="120" ToolTip="{l:T ProductEditor.SaveAndNewTip}" />
                <Button Content="{l:T ProductEditor.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0" MinWidth="120" />
            </StackPanel>
            <!-- Entering several similar items in a row -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <CheckBox IsChecked="{Binding KeepDetails}" Margin="0" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"
                          ToolTip="{l:T ProductEditor.KeepDetailsTip}">
                    <TextBlock Text="{l:T ProductEditor.KeepDetails}" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Text="{Binding SavedMessage}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding SavedMessage, Converter={StaticResource HasValueToVis}}" />
            </StackPanel>
        </DockPanel>
        <Grid infra:LayoutMemory.Key="ProductEditor" infra:PanelFit.IsEnabled="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- The item -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{l:T ProductEditor.NameRequired}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14" />

                    <TextBlock Text="{l:T ProductEditor.CategoryRequired}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T Menu.Price}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Price, StringFormat=0.00}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T Menu.Cost}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Cost, StringFormat=0.00}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MarginText}" Style="{StaticResource HintText}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T Menu.Code}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Code}" Tag="{l:T Menu.CodeAuto}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T Menu.Barcode}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Barcode}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{l:T Menu.CodeHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" />

                    <TextBlock Text="{l:T Common.Description}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Description}" Style="{StaticResource MultilineBox}" />

                    <CheckBox IsChecked="{Binding SoldOut}" Margin="0,14,0,0">
                        <TextBlock Text="{l:T Menu.SoldOutNow}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IsActive}" Margin="0,8,0,0">
                        <TextBlock Text="{l:T Menu.OnTheMenu}" TextWrapping="Wrap" />
                    </CheckBox>

                    <!-- Stock: packaged goods only -->
                    <CheckBox IsChecked="{Binding TrackStock}" Margin="0,16,0,0">
                        <TextBlock Text="{l:T Menu.TrackStock}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="{l:T Menu.TrackStockHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="24,2,0,0" />
                    <Grid Margin="24,0,0,0" Visibility="{Binding TrackStock, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{l:T Menu.OpeningStock}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding OpeningStock}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="{l:T Menu.InStock}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StockOnHand, Mode=OneWay}" IsReadOnly="True" ToolTip="{l:T Menu.InStockTip}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T Menu.ReorderLevel}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ReorderLevel}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="24,0,0,0" Visibility="{Binding TrackStock, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{l:T Common.Supplier}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

            <!-- The questions asked when it is ordered -->
            <DockPanel Grid.Column="2" Margin="8,0,0,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{l:T Menu.OptionsTitle}" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Text="{l:T Menu.OptionsHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                </StackPanel>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Width="30" Height="30" ToolTip="{l:T Menu.MoveUp}"
                                                        Command="{Binding DataContext.MoveGroupUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Width="30" Height="30" ToolTip="{l:T Menu.MoveDown}"
                                                        Command="{Binding DataContext.MoveGroupDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{l:T Menu.NoGroupsYet}" Style="{StaticResource MutedText}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Groups.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
