<UserControl x:Class="UniPos.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UniPos.Desktop.Localization"
             xmlns:infra="clr-namespace:UniPos.Desktop.Infrastructure">
    <DockPanel>
        <DockPanel Style="{StaticResource Toolbar}" DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:T Menu.ToggleSoldOut}" Command="{Binding ToggleSoldOutCommand}" ToolTip="{l:T Menu.ToggleSoldOutTip}"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                <Button Content="{l:T Common.Delete}" Command="{Binding DeleteCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                <Button Content="{l:T Common.Edit}" Command="{Binding EditCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                <Button Content="{l:T Products.NewButton}" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Margin="0"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <!-- Wraps onto a second line in a narrow window instead of cutting the filters off -->
            <WrapPanel>
                <TextBox Style="{StaticResource FilterBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{l:T Products.SearchHint}" Width="320" Margin="0,0,10,0" />
                <ComboBox infra:SmartCombo.IsEnabled="True" Tag="{l:T Common.TypeToSearch}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Width="190" Margin="0,0,14,0" />
                <CheckBox Content="{l:T Common.IncludeInactive}" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center" />
            </WrapPanel>
        </DockPanel>

        <Border Style="{StaticResource TableCard}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding CappedText}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" Margin="12,8"
                           TextWrapping="Wrap" Visibility="{Binding IsCapped, Converter={StaticResource BoolToVis}}" />
                <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                          MouseDoubleClick="OnDoubleClick" infra:LayoutMemory.Key="Products.List">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Product.IsActive}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T Common.Product}" Binding="{Binding Product.Name}" Width="2*" MinWidth="160" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="{l:T Common.Category}" Binding="{Binding Product.Category.Name}" Width="*" MinWidth="130" />
                        <DataGridTextColumn Header="{l:T Menu.Code}" Binding="{Binding Product.Sku}" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn Header="{l:T Common.Price}" Binding="{Binding PriceText}" Width="Auto" MinWidth="90" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="{l:T Menu.OptionsColumn}" Binding="{Binding OptionsText}" Width="2*" MinWidth="160" />
                        <DataGridTemplateColumn Header="{l:T Common.Stock}" Width="Auto" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Stock}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLowStock}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="{l:T Menu.SoldOut}" Binding="{Binding Product.SoldOut, Mode=OneWay}" IsReadOnly="True" Width="Auto" MinWidth="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
