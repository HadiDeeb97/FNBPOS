<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UniPos.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Pulled in by Microsoft.Data.SqlClient at 9.0.11, which has known security advisories: pinned to a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniPos.Core\UniPos.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The online reports website (cloud/reports-worker), which the POS publishes to the shop's Cloudflare account. -->
    <EmbeddedResource Include="..\..\cloud\reports-worker\src\**\*" LogicalName="ReportsWorker/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UniPos.Tests" />
  </ItemGroup>

</Project>
