<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vendor app: issue and renew customers' license keys without the command line. Never ship it to customers. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>LicenseMaker</AssemblyName>
    <RootNamespace>UniPos.LicenseMaker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UniPos.Core\UniPos.Core.csproj" />
  </ItemGroup>

</Project>
